<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <declare-styleable name="MinMaxNumberPicker">
        <attr name="min" format="integer" />
        <attr name="max" format="integer" />
    </declare-styleable>

    <attr name="actionBarTintColor" format="color" />
    <attr name="readerBackground" format="color" />
    <attr name="colorOnSecondary" format="color" />
    <attr name="colorOnTertiary" format="color" tools:ignore="PrivateResource" />
    <attr name="colorTertiary" format="color" tools:ignore="PrivateResource" />
    <attr name="textAppearanceBodySecondary" format="reference" />
    <attr name="tabBarIconColor" format="reference|integer" />
    <attr name="tabBarIconInactive" format="reference|integer" />
    <attr name="mainActionBarSize" format="dimension" />
    <attr name="tabHighlightBackground" format="color" />
    <attr name="hasColoredActionBar" format="boolean">false</attr>
    <attr name="unreadBadgeColor" format="color" />
    <attr name="colorOnUnreadBadge" format="color" />
    <attr name="colorDownloadBadge" format="color" />
    <attr name="colorOnDownloadBadge" format="color" />
    <attr name="colorOnHopper" format="color" />

    <bool name="isLightMode">true</bool>

</resources>
